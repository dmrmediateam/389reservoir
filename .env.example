# ---- Lead email (SendGrid) ----------------------------------------------
# Same setup as the Carole Tierney / Alexa Devaney sites. The FROM address
# must be a verified sender (or on an authenticated domain) in SendGrid.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Name on the auto-responder; defaults to the agent's name in site.config.ts
SENDGRID_FROM_NAME=
# Comma-separated. Defaults to agent.email in site.config.ts.
# Put the agent AND the DMR ads inbox here so both see every lead.
LEAD_NOTIFY_EMAIL=
# Instant "thanks, here's what happens next" email to the lead (1 = on)
# LEAD_AUTORESPONDER=1

# ---- CRM push (optional) ------------------------------------------------
# Zapier / Make catch hook. Receives a flat JSON lead incl. gclid + UTMs.
# LEAD_WEBHOOK_URL=

# ---- Lead texts (optional, Twilio) --------------------------------------
# Only QUALIFIED leads text the agent.
# LEAD_NOTIFY_SMS=+15555550100
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM_NUMBER=
